<project
        name="common"
        brief="Virgil Security Crypto Common"
        namespace="virgil crypto common"
        framework="VSCCommon"
        prefix="vsc"
        path="../library/common/"
        work_path="generated/common/"
        wrappers="python"
        >

    <version major="0" minor="21" patch="0"/>

    <module name="assert" from="shared"/>
    <module name="library" from="shared"/>
    <module name="memory" from="shared"/>
    <module name="atomic" from="shared"/>

    <feature name="multi threading" default="on">
        Enable multi-threading safety for foundation library.
    </feature>

    <class name="data"/>
    <class name="buffer"/>
</project>
